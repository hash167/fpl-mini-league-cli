# Ignore everything by default
*

# Keep git config files
!.gitignore
!.gitattributes

# Keep source
!src/
!src/**

# Keep docs
!docs/
!docs/**

# Keep project/build definitions
!README.md
!build.gradle.kts
!settings.gradle.kts
!gradle.properties
!gradlew
!gradlew.bat

# Keep Gradle wrapper files required for reproducible builds
!gradle/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Webapp / deploy
!Dockerfile
!Dockerfile.runtime
!config.yml
!k8s/
!k8s/**
!.dockerignore

# Repo metadata and helper scripts
!LICENSE
!scripts/
!scripts/**

# Secret-scanning config (2026-10-24)
!.pre-commit-config.yaml
!ci/
!ci/**
!.github/
!.github/**

# --- secrets hygiene (2026-10-24): re-ignore secret-looking files even under allowed dirs ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.kubeconfig
kubeconfig*
k3s.yaml
*-secret.yaml
*-secrets.yaml
secrets.y*ml
credentials.json
*-creds.json
*tunnel-token*
gitleaks-report*.json
