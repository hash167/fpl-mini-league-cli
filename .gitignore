# Ignore everything by default
*

# Keep git config files
!.gitignore
!.gitattributes

# Keep source
!src/
!src/**

# Keep docs
!docs/
!docs/**

# Keep project/build definitions
!README.md
!build.gradle.kts
!settings.gradle.kts
!gradle.properties
!gradlew
!gradlew.bat

# Keep Gradle wrapper files required for reproducible builds
!gradle/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Webapp / deploy
!Dockerfile
!Dockerfile.runtime
!config.yml
!k8s/
!k8s/**
!.dockerignore
